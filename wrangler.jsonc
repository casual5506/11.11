{
  // public 폴더의 정적 파일을 서비스하고, /api/* 요청만 src/worker.js가 처리한다
  "name": "ppbox",
  "main": "src/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // id를 비워 두면 배포할 때 wrangler가 KV 저장소를 자동으로 만든다
  "kv_namespaces": [{ "binding": "LINKS" }]
}
